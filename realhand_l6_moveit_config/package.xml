<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realhand_l6_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt configuration for the RealHand L6, an SRDF macro for arm and hand configs plus a standalone hand demo.</description>
  <maintainer email="enwerem@terpmail.umd.edu">Clinton Enwerem</maintainer>
  <license>Apache-2.0</license>
  <author email="enwerem@terpmail.umd.edu">Clinton Enwerem</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>realhand_l6_bringup</exec_depend>
  <exec_depend>realhand_l6_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>moveit_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
