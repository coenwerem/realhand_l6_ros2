<?xml version="1.0"?>
<!--
  Standalone RealHand L6, hand base fixed to a world link.

  Args
    prefix         link and joint name prefix, default empty
    side           right or left
    hardware       none, mock, or real. none emits no ros2_control block
    can_interface  SocketCAN device for real hardware
    can_id         explicit CAN id, empty selects the side default
    enable_tactile request taxel matrices from the hand
    taxel_topic    optional raw taxel JSON topic
    setpoints      speed and torque command interfaces on actuated joints
    use_object     add a graspable object on a fixed joint at the hand base
    object_size    object edge length in meters
    object_xyz     object center in the hand base frame
    object_rpy     object orientation in the hand base frame
    object_rgba    object material color
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="realhand_l6">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="side" default="right"/>
  <xacro:arg name="hardware" default="none"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="can_id" default=""/>
  <xacro:arg name="enable_tactile" default="true"/>
  <xacro:arg name="taxel_topic" default=""/>
  <xacro:arg name="setpoints" default="true"/>
  <xacro:arg name="use_object" default="false"/>
  <xacro:arg name="object_size" default="0.055"/>
  <xacro:arg name="object_xyz" default="0.065 0.005 0.08"/>
  <xacro:arg name="object_rpy" default="0 0 0"/>
  <xacro:arg name="object_rgba" default="0.43 0.6 0.78 1.0"/>

  <xacro:include filename="realhand_l6_macro.xacro"/>
  <xacro:include filename="realhand_l6.ros2_control.xacro"/>

  <link name="world"/>

  <xacro:realhand_l6 prefix="$(arg prefix)" side="$(arg side)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:realhand_l6>

  <!-- Cube on a fixed joint at the hand base, standing in for the grasped
       object. The mock contact surface emulates its per finger contact
       depths, so the demo shows the fingers gripping its faces. -->
  <xacro:if value="$(arg use_object)">
    <material name="object_material">
      <color rgba="$(arg object_rgba)"/>
    </material>
    <link name="$(arg prefix)object_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="$(arg object_size) $(arg object_size) $(arg object_size)"/>
        </geometry>
        <material name="object_material"/>
      </visual>
    </link>
    <joint name="$(arg prefix)hand_base_to_object" type="fixed">
      <parent link="$(arg prefix)hand_base_link"/>
      <child link="$(arg prefix)object_link"/>
      <origin xyz="$(arg object_xyz)" rpy="$(arg object_rpy)"/>
    </joint>
  </xacro:if>

  <xacro:unless value="${'$(arg hardware)' == 'none'}">
    <xacro:realhand_l6_ros2_control
      name="$(arg prefix)realhand_l6_$(arg side)"
      prefix="$(arg prefix)"
      side="$(arg side)"
      hardware="$(arg hardware)"
      can_interface="$(arg can_interface)"
      can_id="$(arg can_id)"
      enable_tactile="$(arg enable_tactile)"
      taxel_topic="$(arg taxel_topic)"
      setpoints="$(arg setpoints)"/>
  </xacro:unless>

</robot>
