<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realhand_l6_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, controller configuration, contact visualizer, and mock feeders for the RealHand L6 ros2_control stack.</description>
  <maintainer email="enwerem@terpmail.umd.edu">Clinton Enwerem</maintainer>
  <license>Apache-2.0</license>
  <author email="enwerem@terpmail.umd.edu">Clinton Enwerem</author>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>realhand_contact_controller</exec_depend>
  <exec_depend>realhand_hardware</exec_depend>
  <exec_depend>realhand_l6_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
